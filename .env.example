# ATLAS Creative Hub — Supabase configuration (copy to .env.local and fill in).
# .env.local is git-ignored. The NEXT_PUBLIC_* values are safe in the browser
# (RLS protects the data). NEVER put the service_role key in a NEXT_PUBLIC_* var
# — it bypasses RLS and is for the SERVER only.
#
# Get these from: Supabase Dashboard -> Project baswqkhufaoshsxbicct -> Settings -> API
#
# Cloud is OPTIONAL. With the two NEXT_PUBLIC_* values unset, the app runs fully
# local-first on IndexedDB and all auth UI stays hidden.

# --- Public (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Site origin used to build invite/confirm links (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
# Leave unset/false for invite-only. Set to "true" ONLY for a future public launch
# (and also re-enable signups in the Supabase dashboard). The flag alone cannot
# bypass the server — Supabase still rejects signups while they are disabled.
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=false
# Full login wall. Leave false to keep the editor + dashboard usable as a guest
# (local-first); cloud sync still requires sign-in either way. Set "true" to
# require authentication for / and /editor as well (enforced in middleware).
NEXT_PUBLIC_REQUIRE_AUTH=false

# --- Server-only (NEVER prefix with NEXT_PUBLIC; never commit the real value) ---
# Used by the invite-accept Route Handler and scripts/create-invite.mjs to create
# invited accounts and manage invitations via the service role.
SUPABASE_SERVICE_ROLE_KEY=
